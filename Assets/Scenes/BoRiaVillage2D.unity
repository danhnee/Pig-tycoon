  InteractionBoxSize: {x: 2, y: 1.5}
  ActionPromptText: "\u0110\u1ECDc B\u1EA3ng H\u01B0\u01A1ng \u01AF\u1EDBc"
  SubPromptInfo: "Nh\u1EA5n [E] ho\u1EB7c nh\u1EA5p chu\u1ED9t \u0111\u1EC3 t\u01B0\u01A1ng t\xE1c"
  ShowWorldSpacePrompt: 1
  AssignedFunction: 5
  TargetSceneName: MainFarm2D
  TargetArrivalPosition: {x: 0, y: -27.5}
  TransitionLoreQuote: "\"B\u1EA1n \u0111\u1EA9y nh\u1EB9 c\xE1nh c\u1EEDa b\u01B0\u1EDBc v\xE0o trong, h\u01A1i \u1EA5m xua tan s\u1EF1 l\u1EA1nh l\u1EBDo c\u1EE7a m\xE0n s\u01B0\u01A1ng.\""
  InteriorTeleportTarget: {x: 0, y: 0}
  TargetVillager: 0
  LoreTitle: "H\u01AF\u01A0NG \u01AF\u1EDAC L\xC0NG B\u1EDC R\xCCA (KH\u1EAEC G\u1ED6 C\u1ED4)"
  LoreContent: "1. TUY\u1EC6T \u0110\u1ED0I C\u1EA4M S\u1ED0 7: Kh\xF4ng mua b\xE1n, kh\xF4ng c\xE2n \u0111ong s\u1ED1 7.\n2. B\xC1T \xDAP CH\u1EDA L\u1EACT: B\xE1t s\u1EE9t tr\xEAn b\xE0n th\u1EDD \u0111\xE1 ph\u1EA3i lu\xF4n \xFAp mi\u1EC7ng xu\u1ED1ng \u0111\u1EA5t \u0111\u1EC3 phong \u1EA5n kh\xED l\u1EA1nh.\n3. TR\u1EDCI T\u1ED0I KH\xD4NG NH\xCCN L\xCAN: Sau canh ba, n\u1EBFu nghe ti\u1EBFng r\xEDt gi\xF3 tr\xEAn n\xF3c nh\xE0, tuy\u1EC7t \u0111\u1ED1i nh\u1EAFm m\u1EAFt n\u1EB1m im."
  OnCustomAction:
    m_PersistentCalls:
      m_Calls: []
