  BuildingId: village_notice_board
  BuildingDisplayName: "B\u1EA3ng H\u01B0\u01A1ng \u01AF\u1EDBc L\xE0ng B\u1EDD R\xECa"
  BuildingRenderer: {fileID: 54737143}
