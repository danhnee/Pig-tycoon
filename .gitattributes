* text=auto

*.cs text eol=lf
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.asmdef text eol=lf

# PNG trên commit này là con trỏ Git LFS. Lịch sử trước commit migrate vẫn là blob thường.
*.png filter=lfs diff=lfs merge=lfs -text
